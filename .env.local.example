# Copy this file to .env.local and adjust for your environment.
# .env.local is gitignored — never commit it.

# Base URL of the Laravel backend, including the /api suffix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# These must match REVERB_APP_KEY / REVERB_HOST / REVERB_PORT / REVERB_SCHEME
# in the backend's .env. src/lib/echo.ts falls back to matching hardcoded
# defaults when these are unset, but that's a coincidence worth not relying on
# once either side changes.
#
# A mismatch produces no error anywhere — realtime just silently never
# connects, and the UI stops updating without saying why.
#
# Note this is http/https, NOT ws/wss: Laravel Echo derives the WebSocket
# scheme itself. (The mobile app's REVERB_SCHEME *is* ws/wss — both are right.)
NEXT_PUBLIC_REVERB_KEY=shadapp-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
